{"id": "0x00E0", "plain_text": "You want to talk to Saria, right?\n\n[CHOICE:2]Talk to Saria\nNo", "category": "NPC_DIALOGUE", "control_codes": ["COLOR", "COLOR(UNKNOWN_68)", "NEWLINE", "COLOR(UNKNOWN_64)", "TWO_CHOICE", "COLOR(UNKNOWN_66)", "END"], "variables": [], "button_glyphs": [], "choices": ["CHOICE_MARKER"]}
