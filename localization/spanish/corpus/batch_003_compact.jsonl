{"id": "0x00ED", "plain_text": "Remember, you can use Farore's\nWind only in dungeons that have\na dungeon map hidden inside, OK?", "category": "NPC_DIALOGUE", "control_codes": ["UNSKIPPABLE", "COLOR", "COLOR(UNKNOWN_66)", "NEWLINE", "COLOR(UNKNOWN_64)", "END"], "variables": [], "button_glyphs": [], "choices": []}
