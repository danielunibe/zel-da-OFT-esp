{"id": "Hint::RHT_GANON_JOKE04::450", "plain_text": "You'll never deflect my bolts of energy with your sword, then shoot me with those Light Arrows you happen to have.", "category": "RANDOMIZER", "subcategory": "RHT_GANON_JOKE04", "variables": []}
