{"id": "Rando::CUSTOM_MSG::L4670", "id_numeric": null, "source_language": "ENG", "source_file": "soh/soh/Enhancements/randomizer/randomizer.cpp", "source_line_start": 4670, "source_line_end": null, "system": "RANDOMIZER_NPC_DIALOG", "category": "NPC_DIALOGUE", "subcategory": "", "speaker_hint": "UNKNOWN", "context_hint": "", "raw_text": "Hey, mister! I remember you!&It's been a long time!^", "plain_text": "Hey, mister! I remember you!\nIt's been a long time!\n--- PAGE ---", "control_codes": [], "variables": [], "button_glyphs": [], "choices": [], "page_count": 2, "has_color_codes": false, "has_sound_codes": false, "has_dynamic_values": false, "has_player_name": false, "has_button_prompt": false, "is_duplicate_text": false, "duplicate_group": null, "translation_status": "NOT_TRANSLATED", "german_text": "Hallo, mein Herr! Ich erinnere mich an Sie!&Lang ist's her!", "french_text": "Hé, monsieur! Je me souviens de toi!&Ça fait longtemps!", "notes": ""}
