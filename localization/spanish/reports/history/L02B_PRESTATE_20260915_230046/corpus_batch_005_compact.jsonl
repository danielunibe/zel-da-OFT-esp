{"id": "0x0214", "plain_text": "Those who wish to open the path\nsleeping at the bottom of the lake\nmust play the song passed down\nby the Royal Family.", "category": "SIGN", "control_codes": ["QUICKTEXT_ENABLE", "NEWLINE", "COLOR", "COLOR(UNKNOWN_65)", "COLOR(UNKNOWN_64)", "QUICKTEXT_DISABLE", "END"], "variables": [], "button_glyphs": [], "choices": []}
