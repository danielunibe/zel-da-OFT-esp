{"id": "0x0203", "plain_text": "You need a Key to open a door\nthat is locked and chained.", "category": "SIGN", "control_codes": ["SHIFT", "COLOR", "COLOR(UNKNOWN_68)", "COLOR(UNKNOWN_64)", "NEWLINE", "END"], "variables": [], "button_glyphs": [], "choices": []}
