{"id": "0x0230", "plain_text": "If you can overcome the trials in\nthe chambers ahead, then and only\nthen will you be qualified to hold\nour secret treasure!", "category": "SIGN", "control_codes": ["COLOR", "COLOR(UNKNOWN_65)", "COLOR(UNKNOWN_64)", "NEWLINE", "END"], "variables": [], "button_glyphs": [], "choices": []}
