{
    def Scope "Materials"
    {
        def Material "MAT_TEMPLE_MOSAIC_CERAMIC"
        {
            token outputs:surface.connect = </Tokinoma_TempleOfTime/Materials/MAT_TEMPLE_MOSAIC_CERAMIC/PBRShader.outputs:surface>
            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.20, 0.45, 0.70)
                float inputs:roughness = 0.28
                float inputs:metallic = 0.0
                float inputs:specular = 0.90
                token outputs:surface
            }
        }
