+void GfxRenderingAPIDX11::RunTonemappingPass() {
+    if (!mTonemapInitialized) {
+        mTonemapInitialized = true;
+    }
+
+    // Get current backbuffer
+    ComPtr<ID3D11Texture2D> backbuffer_tex;
+    HRESULT hr = mWindowBackend->GetSwapChain()->GetBuffer(0, IID_PPV_ARGS(backbuffer_tex.GetAddressOf()));
+    if (FAILED(hr) || !backbuffer_tex) return;
+
+    D3D11_TEXTURE2D_DESC bb_desc;
+    backbuffer_tex->GetDesc(&bb_desc);
+
+    // Resize copy texture if needed
+    if (!mTonemapCopyTex || bb_desc.Width != mTonemapCopyTexW || bb_desc.Height != mTonemapCopyTexH) {
+        mTonemapCopyTex.Reset();
+        mTonemapCopySRV.Reset();
+
+        D3D11_TEXTURE2D_DESC tex_desc = {};
+        tex_desc.Width = bb_desc.Width;
+        tex_desc.Height = bb_desc.Height;
+        tex_desc.MipLevels = 1;
+        tex_desc.ArraySize = 1;
+        tex_desc.Format = bb_desc.Format;
+        tex_desc.SampleDesc.Count = 1;
+        tex_desc.Usage = D3D11_USAGE_DEFAULT;
+        tex_desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+
+        hr = mDevice->CreateTexture2D(&tex_desc, nullptr, mTonemapCopyTex.GetAddressOf());
+        if (FAILED(hr)) return;
+
+        D3D11_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+        srv_desc.Format = tex_desc.Format;
+        srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        srv_desc.Texture2D.MipLevels = 1;
+
+        hr = mDevice->CreateShaderResourceView(mTonemapCopyTex.Get(), &srv_desc, mTonemapCopySRV.GetAddressOf());
+        if (FAILED(hr)) return;
+
+        mTonemapCopyTexW = bb_desc.Width;
+        mTonemapCopyTexH = bb_desc.Height;
+    }
+
+    // Copy backbuffer to our SRV texture
+    mContext->CopyResource(mTonemapCopyTex.Get(), backbuffer_tex.Get());
+
+    // Save previous state
+    ComPtr<ID3D11RenderTargetView> prev_rtvs[D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    mContext->OMGetRenderTargets(D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, prev_rtvs[0].GetAddressOf(), nullptr);
+    ComPtr<ID3D11VertexShader> prev_vs;
+    ComPtr<ID3D11PixelShader> prev_ps;
+    ComPtr<ID3D11InputLayout> prev_il;
+    mContext->VSGetShader(prev_vs.GetAddressOf(), nullptr, nullptr);
+    mContext->PSGetShader(prev_ps.GetAddressOf(), nullptr, nullptr);
+    mContext->IAGetInputLayout(prev_il.GetAddressOf());
+    D3D11_PRIMITIVE_TOPOLOGY prev_topo;
+    mContext->IAGetPrimitiveTopology(&prev_topo);
+    ComPtr<ID3D11ShaderResourceView> prev_srvs[D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT];
+    mContext->PSGetShaderResources(0, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT, prev_srvs[0].GetAddressOf());
+    ComPtr<ID3D11SamplerState> prev_samplers[D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT];
+    mContext->PSGetSamplers(0, D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT, prev_samplers[0].GetAddressOf());
+    ComPtr<ID3D11RasterizerState> prev_rs;
+    mContext->RSGetState(prev_rs.GetAddressOf());
+    ComPtr<ID3D11BlendState> prev_bs;
+    FLOAT prev_blend_factor[4];
+    UINT prev_sample_mask;
+    mContext->OMGetBlendState(prev_bs.GetAddressOf(), prev_blend_factor, &prev_sample_mask);
+    ComPtr<ID3D11DepthStencilState> prev_dss;
+    UINT prev_stencil_ref;
+    mContext->OMGetDepthStencilState(prev_dss.GetAddressOf(), &prev_stencil_ref);
+    ID3D11Buffer* prev_cb[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT];
+    mContext->PSGetConstantBuffers(0, D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT, prev_cb);
+
+    // Create backbuffer RTV
+    ComPtr<ID3D11RenderTargetView> bb_rtv;
+    hr = mDevice->CreateRenderTargetView(backbuffer_tex.Get(), nullptr, bb_rtv.GetAddressOf());
+    if (FAILED(hr)) return;
+
+    // Set tonemapping state
+    D3D11_VIEWPORT vp = {};
+    vp.Width = (float)bb_desc.Width;
+    vp.Height = (float)bb_desc.Height;
+    vp.MaxDepth = 1.0f;
+    mContext->RSSetViewports(1, &vp);
+
+    D3D11_RECT scissor = { 0, 0, (LONG)bb_desc.Width, (LONG)bb_desc.Height };
+    mContext->RSSetScissorRects(1, &scissor);
+
+    FLOAT black[] = { 0, 0, 0, 0 };
+    mContext->OMSetRenderTargets(1, bb_rtv.GetAddressOf(), nullptr);
+    mContext->OMSetBlendState(nullptr, black, 0xFFFFFFFF);
+    mContext->OMSetDepthStencilState(nullptr, 0);
+
+    D3D11_RASTERIZER_DESC rs_desc = {};
+    rs_desc.FillMode = D3D11_FILL_SOLID;
+    rs_desc.CullMode = D3D11_CULL_NONE;
+    rs_desc.ScissorEnable = true;
+    ComPtr<ID3D11RasterizerState> tonemap_rs;
+    mDevice->CreateRasterizerState(&rs_desc, tonemap_rs.GetAddressOf());
+    mContext->RSSetState(tonemap_rs.Get());
+
+    // Update fog constant buffer
+    FogConstants fogData = {};
+    fogData.fogStart = 0.3f;
+    fogData.fogRange = 0.7f;
+    fogData.fogColorR = 0.45f;
+    fogData.fogColorG = 0.55f;
+    fogData.fogColorB = 0.70f;
+    fogData.fogStrength = 0.15f;
+    D3D11_MAPPED_SUBRESOURCE fogMap;
+    if (SUCCEEDED(mContext->Map(mFogCB.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &fogMap))) {
+        memcpy(fogMap.pData, &fogData, sizeof(FogConstants));
+        mContext->Unmap(mFogCB.Get(), 0);
+    }
+
+    // Get depth buffer SRV for atmospheric fog
+    ID3D11ShaderResourceView* depthSRV = nullptr;
+    if (mCurrentFramebuffer >= 0 && mCurrentFramebuffer < (int)mFrameBuffers.size()) {
+        FramebufferDX11& fb = mFrameBuffers[mCurrentFramebuffer];
+        if (fb.depth_stencil_srv.Get() != nullptr) {
+            depthSRV = fb.depth_stencil_srv.Get();
+        }
+    }
+
+    mContext->IASetInputLayout(mTonemapIL.Get());
+    mContext->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    mContext->VSSetShader(mTonemapVS.Get(), 0, 0);
+    mContext->PSSetShader(mTonemapPS.Get(), 0, 0);
+    mContext->PSSetShaderResources(0, 1, mTonemapCopySRV.GetAddressOf());
+    if (depthSRV) {
+        mContext->PSSetShaderResources(1, 1, &depthSRV);
+    }
+    mContext->PSSetSamplers(0, 1, mTonemapSampler.GetAddressOf());
+    if (depthSRV) {
+        mContext->PSSetSamplers(1, 1, mTonemapSampler.GetAddressOf());
+    }
+    mContext->PSSetConstantBuffers(2, 1, mFogCB.GetAddressOf());
+
+    // Draw fullscreen triangle (SV_VertexID generates vertices)
+    mContext->Draw(3, 0);
+
+    // Restore previous state
+    mContext->OMSetRenderTargets(D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, prev_rtvs[0].GetAddressOf(), nullptr);
+    mContext->VSSetShader(prev_vs.Get(), 0, 0);
+    mContext->PSSetShader(prev_ps.Get(), 0, 0);
+    mContext->IASetInputLayout(prev_il.Get());
+    mContext->IASetPrimitiveTopology(prev_topo);
+    mContext->PSSetShaderResources(0, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT, prev_srvs[0].GetAddressOf());
+    mContext->PSSetSamplers(0, D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT, prev_samplers[0].GetAddressOf());
+    mContext->RSSetState(prev_rs.Get());
+    mContext->OMSetBlendState(prev_bs.Get(), prev_blend_factor, prev_sample_mask);
+    mContext->OMSetDepthStencilState(prev_dss.Get(), prev_stencil_ref);
+    mContext->PSSetConstantBuffers(0, D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT, prev_cb);
+}
