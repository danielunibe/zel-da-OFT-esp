+static constexpr size_t gMaterialRulesPilotCount = sizeof(gMaterialRulesPilot) / sizeof(gMaterialRulesPilot[0]);
+
+inline void PopulateMaterialRulesTable(std::unordered_map<uint64_t, MaterialDefinition>& outRules,
+                                      std::unordered_map<std::string, MaterialDefinition>& outStringRules) {
+    outRules.reserve(gMaterialRulesPilotCount);
+    for (size_t i = 0; i < gMaterialRulesPilotCount; ++i) {
+        const auto& r = gMaterialRulesPilot[i];
+        MaterialDefinition def;
+        def.type = r.type;
+        def.roughness = r.roughness;
+        def.metallic = r.metallic;
+        def.specular = r.specular;
+        def.emissiveStrength = r.emissiveStrength;
+        
+        uint64_t hash = CRC64(r.path);
+        outRules[hash] = def;
+        outStringRules[r.path] = def;
+    }
+}
+
+inline bool IsResourcePathUIProtected(const char* path) {
+    if (!path || path[0] == '\0') return false;
+    static const char* uiPrefixes[] = {
+        "textures/icon_item_static",
+        "textures/parameter_static",
+        "textures/message_static",
+        "textures/title_static",
+        "textures/map_grand_static",
+        "textures/map_i_static",
+        "textures/map_48x85_static",
+        "custom/textures/buttons",
+        "gFont",
+        "Font",
+        "Letter",
+        "Text",
+        "Heart",
+        "Rupee",
+        "Key",
+        "Cursor",
+        "gTitle",
+        "gFileSelect"
+    };
+    for (const char* prefix : uiPrefixes) {
+        if (strstr(path, prefix) != nullptr) return true;
+    }
+    return false;
+}
+
