diff --git a/include/fast/Fast3DAlphaPolicy.h b/include/fast/Fast3DAlphaPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..7d23895069c98319b2e36abada87dfa6cf72d081
--- /dev/null
+++ b/include/fast/Fast3DAlphaPolicy.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <cstdint>
+
+namespace Fast {
+
+enum class Fast3DAlphaClass : uint32_t { Opaque = 0, Cutout = 1, Blended = 2 };
+
+struct Fast3DAlphaState {
+    uint32_t alphaCompare;
+    uint32_t coverageDestination;
+    uint32_t zMode;
+    bool coverageTimesAlpha;
+    bool alphaFromCoverage;
+    bool forceBlender;
+    uint32_t cycleType;
+    uint32_t otherModeL;
+};
+
+constexpr uint32_t Fast3DField(uint32_t word, uint32_t shift, uint32_t mask) {
+    return (word >> shift) & mask;
+}
+
+constexpr bool Fast3DSourceOver(uint32_t word, uint32_t shift) {
+    const uint32_t p = Fast3DField(word, shift, 3u);
+    const uint32_t a = Fast3DField(word, shift - 4u, 3u);
+    const uint32_t m = Fast3DField(word, shift - 8u, 3u);
+    const uint32_t b = Fast3DField(word, shift - 12u, 3u);
+    // G_BL_CLR_IN, G_BL_A_IN, G_BL_CLR_MEM, G_BL_1MA.
+    return p == 0u && a == 0u && m == 1u && b == 0u;
+}
+
+constexpr bool Fast3DAdditive(uint32_t word, uint32_t shift) {
+    const uint32_t p = Fast3DField(word, shift, 3u);
+    const uint32_t a = Fast3DField(word, shift - 4u, 3u);
+    const uint32_t m = Fast3DField(word, shift - 8u, 3u);
+    const uint32_t b = Fast3DField(word, shift - 12u, 3u);
+    // G_BL_CLR_IN, G_BL_A_FOG, G_BL_CLR_MEM, G_BL_1.
+    return p == 0u && a == 1u && m == 1u && b == 2u;
+}
+
+constexpr Fast3DAlphaState DecodeFast3DAlphaState(uint32_t otherModeL, uint32_t otherModeH) {
+    return { otherModeL & 3u, (otherModeL >> 8u) & 3u, (otherModeL >> 10u) & 3u,
+             (otherModeL & 0x1000u) != 0u, (otherModeL & 0x2000u) != 0u,
+             (otherModeL & 0x4000u) != 0u, (otherModeH >> 20u) & 3u, otherModeL };
+}
+
+constexpr Fast3DAlphaClass ClassifyFast3DAlphaCandidate(uint32_t otherModeL, uint32_t otherModeH) {
+    const Fast3DAlphaState state = DecodeFast3DAlphaState(otherModeL, otherModeH);
+    bool sourceOver = false;
+    bool additive = false;
+    if (state.cycleType == 0u) {
+        sourceOver = Fast3DSourceOver(otherModeL, 30u);
+        additive = Fast3DAdditive(otherModeL, 30u);
+    } else if (state.cycleType == 1u) {
+        // Two-cycle othermode stores the two blender equations in opposite
+        // field groups. Either active cycle can establish a blend equation.
+        sourceOver = Fast3DSourceOver(otherModeL, 28u) || Fast3DSourceOver(otherModeL, 30u);
+        additive = Fast3DAdditive(otherModeL, 28u) || Fast3DAdditive(otherModeL, 30u);
+    }
+    if (state.forceBlender && (state.zMode == 2u || sourceOver || additive))
+        return Fast3DAlphaClass::Blended;
+    if (state.alphaCompare != 0u || state.coverageTimesAlpha)
+        return Fast3DAlphaClass::Cutout;
+    return Fast3DAlphaClass::Opaque;
+}
+
+constexpr const char* Fast3DAlphaClassName(Fast3DAlphaClass value) {
+    return value == Fast3DAlphaClass::Blended ? "BLENDED" :
+           value == Fast3DAlphaClass::Cutout ? "CUTOUT" : "OPAQUE";
+}
+
+static_assert((0x00000001u & 3u) == 1u, "G_AC_THRESHOLD occupies alpha-compare bits 0..1");
+static_assert((0x00001000u & 0x00001000u) != 0u, "CVG_X_ALPHA is bit 12");
+static_assert((0x00004000u & 3u) == 0u, "FORCE_BL is not alpha compare");
+static_assert(Fast3DSourceOver((0u << 30u) | (0u << 26u) | (1u << 22u) | (0u << 18u), 30u),
+              "GBL_c1 source-over selector contract");
+static_assert(Fast3DAdditive((0u << 30u) | (1u << 26u) | (1u << 22u) | (2u << 18u), 30u),
+              "GBL_c1 additive selector contract");
+static_assert(ClassifyFast3DAlphaCandidate(0x00004000u | (3u << 26u) | (2u << 18u), 0u) ==
+                  Fast3DAlphaClass::Opaque,
+              "FORCE_BL with opaque blender equation must remain opaque");
+static_assert(ClassifyFast3DAlphaCandidate(0x00004000u | (1u << 22u), 0u) ==
+                  Fast3DAlphaClass::Blended,
+              "source-over blender control must remain blended");
+static_assert(ClassifyFast3DAlphaCandidate(0x00001000u, 0u) == Fast3DAlphaClass::Cutout,
+              "CVG_X_ALPHA control must classify as cutout");
+static_assert(ClassifyFast3DAlphaCandidate(0x00000001u, 0u) == Fast3DAlphaClass::Cutout,
+              "G_AC_THRESHOLD control must classify as cutout");
+static_assert(ClassifyFast3DAlphaCandidate(0x00004800u, 0u) == Fast3DAlphaClass::Blended,
+              "ZMODE_XLU control must remain blended");
+
+} // namespace Fast
diff --git a/include/fast/GeometryCapture.h b/include/fast/GeometryCapture.h
new file mode 100644
index 0000000000000000000000000000000000000000..c8c01650fd3aedbe962fe681590e18b29ee9bb17
--- /dev/null
+++ b/include/fast/GeometryCapture.h
@@ -0,0 +1,200 @@
+#pragma once
+
+#include <stdint.h>
+#include <string>
+#include <vector>
+#include <unordered_map>
+#include <memory>
+#include "fast/MaterialRegistry.h"
+
+namespace Fast {
+
+enum NormalStatus : uint8_t {
+    NORMAL_SOURCE_UNAVAILABLE = 0,
+    NORMAL_SOURCE_AVAILABLE   = 1,
+    NORMAL_DERIVED            = 2
+};
+
+enum AlphaMode : uint8_t {
+    ALPHA_OPAQUE      = 0,
+    ALPHA_TEST        = 1,
+    ALPHA_TRANSPARENT = 2,
+    ALPHA_ADDITIVE    = 3,
+    ALPHA_UNKNOWN     = 4
+};
+
+enum SurfaceCategory : uint8_t {
+    SURFACE_WORLD_STATIC   = 0,
+    SURFACE_ACTOR_DYNAMIC  = 1,
+    SURFACE_BILLBOARD      = 2,
+    SURFACE_SPRITE         = 3,
+    SURFACE_PARTICLE       = 4,
+    SURFACE_SKYBOX         = 5,
+    SURFACE_UI_2D          = 6
+};
+
+struct CapturedVertex {
+    float posX, posY, posZ;         // Espacio Local de Objeto / Modelo
+    float worldX, worldY, worldZ;   // Espacio de Mundo (sin matriz de proyección)
+    float normX, normY, normZ;      // Normal unitaria
+    float u, v;                     // Coordenadas UV normalizadas
+    uint32_t color;                 // Color RGBA
+    uint8_t normalStatus;           // NormalStatus
+    uint8_t sourceAlpha;            // Original F3DVtx.cn[3] before fog reuse
+    uint8_t recordLoadedAlpha;      // LoadedVertex.color.a passed to GeometryCapture
+    uint8_t fogMode;                // G_FOG active when this RSP vertex was loaded
+};
+
+struct CapturedDraw {
+    uint32_t vertexStart;
+    uint32_t vertexCount;
+    uint32_t indexStart;
+    uint32_t indexCount;
+
+    float worldTransform[4][4];     // Matriz ModelView de instancia sin proyección
+
+    uint64_t geometryHash;          // Hash único de geometría local e índices
+    uint64_t materialId;            // Identificador de MaterialRegistry
+    MaterialDefinition material;     // Snapshot de parámetros del draw capturado
+    uint64_t resourceId;            // Hash CRC64 estable del recurso de textura
+    std::string resourcePath;       // Ruta OTR si está disponible
+
+    uint32_t geometryMode;
+    uint32_t otherModeL;
+    uint32_t otherModeH;
+    uint64_t combineMode;
+    uint8_t alphaMode;              // AlphaMode
+    uint8_t surfaceCategory;        // SurfaceCategory
+
+    bool isStatic;
+    bool isDynamic;
+    bool isUI;
+    bool isWorld;
+};
+
+struct CapturedAssetSummary {
+    uint64_t geometryHash;
+    uint32_t vertexCount;
+    uint32_t triangleCount;
+    uint32_t instanceCount;
+    uint64_t firstMaterialId;
+    std::string firstResourcePath;
+};
+
+struct SceneCaptureStats {
+    uint32_t totalDraws;
+    uint32_t worldDraws;
+    uint32_t uiDraws;
+
+    uint32_t totalVertices;
+    uint32_t totalIndices;
+    uint32_t totalTriangles;
+
+    uint32_t staticDraws;
+    uint32_t dynamicDraws;
+
+    uint32_t opaqueDraws;
+    uint32_t alphaTestDraws;
+    uint32_t transparentDraws;
+    uint32_t unknownAlphaDraws;
+
+    uint32_t uniqueGeometryAssets;
+    uint32_t instanceCount;
+
+    uint32_t normalAvailableCount;
+    uint32_t normalDerivedCount;
+    uint32_t normalUnavailableCount;
+
+    uint32_t materialCount;
+    uint32_t unknownMaterialCount;
+};
+
+class GeometryCapture {
+public:
+    static GeometryCapture& Instance();
+
+    void Init();
+    bool IsEnabled() const { return mEnabled; }
+    void SetEnabled(bool enabled) { mEnabled = enabled; }
+
+    void BeginFrame();
+    void EndFrame();
+
+    void SetCurrentScene(int sceneId, int roomId);
+    int GetCurrentSceneId() const { return mCurrentSceneId; }
+    int GetCurrentRoomId() const { return mCurrentRoomId; }
+
+    // Intercepción durante el procesamiento de vértices y triángulos
+    void RecordLoadedVertex(uint16_t vtxIdx, float objX, float objY, float objZ,
+                            float normX, float normY, float normZ, bool hasNormal,
+                            float u, float v, uint32_t color,
+                            uint8_t sourceAlpha, bool fogMode);
+
+    void RecordTriangle(uint16_t idx0, uint16_t idx1, uint16_t idx2);
+
+    void FlushDraw(const float transform[4][4], uint64_t materialId,
+                   const MaterialDefinition& material,
+                   uint64_t resourceId, const std::string& resourcePath,
+                   uint32_t geometryMode, uint32_t otherModeL, uint32_t otherModeH,
+                   uint64_t combineMode, bool isDepthTest, bool isDecal);
+
+    // Exportación de snapshots
+    bool ExportSnapshot(const std::string& outputPath);
+    void RequestSnapshot(const std::string& outputPath) {
+        mRequestedSnapshotPath = outputPath;
+        mSnapshotRequested = true;
+    }
+
+    const SceneCaptureStats& GetStats() const { return mStats; }
+    const std::vector<CapturedDraw>& GetDraws() const { return mDraws; }
+    const std::vector<CapturedVertex>& GetVertices() const { return mVertices; }
+    const std::string& GetCaptureSessionId() const { return mCaptureSessionId; }
+
+    void ClearScene();
+
+private:
+    GeometryCapture();
+    ~GeometryCapture();
+
+    uint64_t ComputeGeometryHash(uint32_t vtxStart, uint32_t vtxCount,
+                                 uint32_t idxStart, uint32_t idxCount);
+
+    bool mEnabled;
+    bool mInitialized;
+    std::string mCaptureSessionId;
+    int mCurrentSceneId;
+    int mCurrentRoomId;
+    uint64_t mFrameCounter;
+
+    bool mSnapshotRequested;
+    std::string mRequestedSnapshotPath;
+
+    // Buffers persistentes preasignados
+    std::vector<CapturedVertex> mVertices;
+    std::vector<uint32_t> mIndices;
+    std::vector<CapturedDraw> mDraws;
+
+    // Buffer temporal de vértices cargados en RSP para el microcódigo actual
+    struct RSPVertexCache {
+        float objX, objY, objZ;
+        float normX, normY, normZ;
+        bool hasNormal;
+        float u, v;
+        uint32_t color;
+        uint8_t sourceAlpha;
+        bool fogMode;
+        bool valid;
+    };
+    RSPVertexCache mRspVertices[128];
+
+    // Acumulador de triángulos pendientes antes de Flush
+    std::vector<uint32_t> mPendingIndices;
+    std::vector<CapturedVertex> mPendingVertices;
+
+    // Deduplicación e instancing
+    std::unordered_map<uint64_t, CapturedAssetSummary> mUniqueAssets;
+
+    SceneCaptureStats mStats;
+};
+
+} // namespace Fast
diff --git a/include/fast/MaterialRegistry.h b/include/fast/MaterialRegistry.h
new file mode 100644
index 0000000000000000000000000000000000000000..581255d3a0c48c57587e00e03f872404e5922221
--- /dev/null
+++ b/include/fast/MaterialRegistry.h
@@ -0,0 +1,228 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include <mutex>
+
+namespace Fast {
+
+enum class MaterialType : uint8_t {
+    CLASSIC = 0,
+    STONE,
+    WOOD,
+    METAL,
+    WATER,
+    GLASS,
+    FABRIC,
+    EARTH,
+    GRASS,
+    FOLIAGE,
+    SAND,
+    LAVA,
+    ICE,
+    MAGIC,
+    EMISSIVE,
+    SKY,
+    CHARACTER,
+    CERAMIC,
+    GENERIC_MATTE,
+    PROTECTED_2D,
+    UNKNOWN
+};
+
+// Classic and Enhanced preserve the original presentation. The two RTX tiers
+// require a supported DXR adapter; path lighting is an opt-in experimental
+// profile exposed in the graphics settings.
+enum class VisualProfileId : int {
+    CLASSIC = 0,
+    ENHANCED = 1,
+    HYBRID_RT = 2,
+    PATH_TRACED_EXPERIMENTAL = 3,
+};
+
+struct MaterialDefinition {
+    MaterialType type = MaterialType::CLASSIC;
+    float roughness = 0.5f;
+    float metallic = 0.0f;
+    float specular = 0.0f;
+    float reflectivity = 0.0f;
+    float emissiveStrength = 0.0f;
+    float normalStrength = 0.0f;
+    float wetness = 0.0f;
+    float subsurfaceHint = 0.0f;
+    uint32_t flags = 0;
+};
+
+inline constexpr uint32_t MATERIAL_FLAG_ALBEDO_TEXTURE_VALID = 1u << 0;
+// Opt in only when the authored albedo intentionally encodes relief detail.
+inline constexpr uint32_t MATERIAL_FLAG_ALBEDO_AS_HEIGHT = 1u << 1;
+
+struct SceneLightingSnapshot {
+    float worldDirection[3] = { 0.22f, 0.94f, 0.26f };
+    float directionalColor[3] = { 1.0f, 1.0f, 1.0f };
+    float secondaryWorldDirection[3] = {};
+    float secondaryDirectionalColor[3] = {};
+    float ambientColor[3] = { 0.12f, 0.12f, 0.12f };
+    float pointPosition[32][4] = {}; // world-space xyz, w: authored influence radius
+    float pointOptics[32][4] = {};   // x: reserved, yzw: linear RGB color
+    uint32_t directionalLightCount = 0;
+    uint32_t pointLightCount = 0;
+    bool capturedFromScene = false;
+    uint64_t gameProbeGameFrame = 0;
+    uint64_t gameProbeRenderFrame = 0;
+    uint64_t productiveGameFrame = 0;
+    uint64_t productiveRenderFrame = 0;
+    uint64_t renderFrame = 0;
+    // DXR TRUTH MODE (V2) game-light probe: read-only observation of the real
+    // OoT/Fast3D directionals captured per draw-flush by the interpreter
+    // (brightest-by-luminance wins across flushes of the frame). This probe is
+    // consumed ONLY by the GAME_LIGHT truth view + provenance log; it never
+    // feeds productive lighting (fc.reservedLight/sceneLightColor paths above
+    // are untouched). Reset every frame by BeginLightingFrame (snapshot {}).
+    float gameProbeWorldDirection[3] = {};
+    float gameProbeColor[3] = {};
+    float gameProbeRawLength = 0.0f; // |dir| BEFORE interpreter normalize
+    float gameProbeLuminance = 0.0f;
+    uint32_t gameProbeDirectionalCount = 0; // distinct dirs seen this frame
+    uint32_t gameProbePointFlushMax = 0;    // max per-flush point count seen
+    bool gameProbeValid = false;
+};
