 bool ResourceManager::OtrSignatureCheck(const char* fileName) {
+    if (fileName == nullptr || (uintptr_t)fileName < 0x10000) {
+        return false;
+    }
+#ifdef _WIN32
+    MEMORY_BASIC_INFORMATION mbi;
+    if (VirtualQuery(fileName, &mbi, sizeof(mbi)) == 0 ||
+        mbi.State != MEM_COMMIT ||
+        (mbi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)) == 0) {
+        return false;
+    }
+    __try {
+        static const char* sOtrSignature = "__OTR__";
+        return strncmp(fileName, sOtrSignature, 7) == 0;
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+#else
+#if defined(__unix__) || defined(__APPLE__) || defined(__linux__)
+    int nullFd = open("/dev/null", O_WRONLY);
+    if (nullFd >= 0) {
+        ssize_t written = write(nullFd, fileName, 7);
+        close(nullFd);
+        if (written != 7) {
+            return false;
+        }
+    }
+#endif
     static const char* sOtrSignature = "__OTR__";
-    return strncmp(fileName, sOtrSignature, strlen(sOtrSignature)) == 0;
