+DxrShadowRenderer::~DxrShadowRenderer() {
+    if (mConstantBuffer && mConstantBufferMapped) {
+        mConstantBuffer->Unmap(0, nullptr);
+        mConstantBufferMapped = nullptr;
+    }
+}
