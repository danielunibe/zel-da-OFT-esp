diff --git a/include/fast/backends/DxrDescriptorRing.h b/include/fast/backends/DxrDescriptorRing.h
new file mode 100644
index 0000000000000000000000000000000000000000..0a14b9be3b0907fe37fb667fb37aa967d0c39ef3
--- /dev/null
+++ b/include/fast/backends/DxrDescriptorRing.h
@@ -0,0 +1,38 @@
+#pragma once
+#if defined(_WIN32)
+#include <d3d12.h>
+#include <wrl/client.h>
+#include <array>
+#include <stdexcept>
+namespace Fast {
+inline void InitializeDxrDescriptorTemplate(ID3D12Device* device,ID3D12DescriptorHeap* heap) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC nullView{};
+    nullView.Format=DXGI_FORMAT_R8G8B8A8_UNORM;
+    nullView.ViewDimension=D3D12_SRV_DIMENSION_TEXTURE2D;
+    nullView.Shader4ComponentMapping=D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    nullView.Texture2D.MipLevels=1;
+    auto handle=heap->GetCPUDescriptorHandleForHeapStart();
+    const auto stride=device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    for (UINT i=0;i<heap->GetDesc().NumDescriptors;++i,handle.ptr+=stride)
+        device->CreateShaderResourceView(nullptr,&nullView,handle);
+}
+// Static descriptors are authored in a CPU-only heap. Each in-flight frame
+// gets a shader-visible copy so later CPU writes cannot alter queued work.
+template<size_t N>
+void SelectDxrDescriptorHeap(ID3D12Device* device,
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap>& active,
+    Microsoft::WRL::ComPtr<ID3D12DescriptorHeap>& cpuTemplate,
+    std::array<Microsoft::WRL::ComPtr<ID3D12DescriptorHeap>,N>& frames,size_t slot) {
+    if (!cpuTemplate) cpuTemplate=active;
+    slot%=N;
+    if (!frames[slot]) {
+        auto desc=cpuTemplate->GetDesc(); desc.Flags=D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(device->CreateDescriptorHeap(&desc,IID_PPV_ARGS(&frames[slot]))))
+            throw std::runtime_error("DXR descriptor ring allocation failed");
+        device->CopyDescriptorsSimple(desc.NumDescriptors,frames[slot]->GetCPUDescriptorHandleForHeapStart(),
+            cpuTemplate->GetCPUDescriptorHandleForHeapStart(),D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    }
+    active=frames[slot];
+}
+}
+#endif
diff --git a/include/fast/backends/DxrPipelinePolicy.h b/include/fast/backends/DxrPipelinePolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..494240276ba5c278f30cc481f12e3918548565d9
--- /dev/null
+++ b/include/fast/backends/DxrPipelinePolicy.h
@@ -0,0 +1,91 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace Fast {
+// Only the two explicit DXR profiles may execute rays. Environment switches
+// can opt features out, but cannot silently promote a raster profile.
+inline bool DxrFeatureAllowed(const char* name, bool defaultValue = true) {
+    const char* value = std::getenv(name);
+    if (value && std::strcmp(value, "0") == 0) return false;
+    if (value && std::strcmp(value, "1") == 0) return true;
+    return defaultValue;
+}
+enum class DxrVisualProfile : int {
+    Classic = 0,
+    Enhanced = 1,
+    HybridRt = 2,
+    PathTracedExperimental = 3,
+};
+
+constexpr bool DxrProfileSelected(int profile) {
+    return profile == static_cast<int>(DxrVisualProfile::HybridRt) ||
+           profile == static_cast<int>(DxrVisualProfile::PathTracedExperimental);
+}
+
+struct DxrFrameEvidence {
+    int frame = -1;
+    bool requested = false;
+    bool adapterCompatible = false;
+    bool tlasValid = false;
+    uint64_t dispatchCalls = 0;
+    uint64_t signalOutputsWritten = 0;
+    uint64_t compositeDraws = 0;
+
+    constexpr bool DispatchExecuted() const {
+        return requested && adapterCompatible && tlasValid && dispatchCalls > 0;
+    }
+    constexpr bool SignalsProduced() const {
+        return DispatchExecuted() && signalOutputsWritten > 0;
+    }
+    constexpr bool CompositionExecuted() const {
+        return SignalsProduced() && compositeDraws > 0;
+    }
+};
+
+struct DxrCaptureEvidence {
+    int frame = -1;
+    int requestSequence = 0;
+    bool dimensionsValid = false;
+    bool formatValid = false;
+    bool payloadCompleteAndReadable = false;
+    bool finiteSignals = false;
+    bool requestMatches = false;
+};
+
+constexpr bool DxrCaptureSetComplete(const std::array<DxrCaptureEvidence, 8>& captures) {
+    const int frame = captures[0].frame;
+    const int sequence = captures[0].requestSequence;
+    if (frame < 0 || sequence <= 0) return false;
+    for (const auto& capture : captures) {
+        if (capture.frame != frame || capture.requestSequence != sequence ||
+            !capture.dimensionsValid || !capture.formatValid ||
+            !capture.payloadCompleteAndReadable || !capture.finiteSignals ||
+            !capture.requestMatches) return false;
+    }
+    return true;
+}
+
+constexpr const char* DxrCaptureStageId(int slot) {
+    switch (slot) {
+        case 0: return "RASTER_HDR";
+        case 1: return "COMPOSITE_PRE_TONEMAP";
+        case 2: return "RASTER_SCENE_COLOR_COPY";
+        case 3: return "POST_ACES_PRE_PRESENT";
+        case 4: return "FINAL_SDR_PRE_PRESENT";
+        case 5: return "DXR_REFLECTION_RGBA16F";
+        case 6: return "DXR_INDIRECT_RGBA16F";
+        case 7: return "EMISSIVE_MASK";
+        default: return "UNKNOWN";
+    }
+}
+
+// A successful DXGI Present call confirms API acceptance only. It cannot
+// certify that pixels reached a physical display or were visible to a person.
+constexpr bool DxrVisualContributionVerified(bool causalAblationEvidence,
+                                             const DxrFrameEvidence& frame) {
+    return causalAblationEvidence && frame.CompositionExecuted();
+}
+}
diff --git a/include/fast/backends/DxrSequencePolicy.h b/include/fast/backends/DxrSequencePolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..60a13c5f4881e1538c403a2d37cc0857c2d6e2fb
--- /dev/null
+++ b/include/fast/backends/DxrSequencePolicy.h
@@ -0,0 +1,67 @@
+#pragma once
+
+namespace Fast {
+
+enum class DxrSequenceMode {
+    None,
+    Diagnostic,
+    TruthV1,
+    TruthV2,
+    GateCounter,
+};
+
+constexpr DxrSequenceMode SelectDxrSequenceMode(bool diagnostic,
+                                                 bool truthV1,
+                                                 bool truthV2,
+                                                 bool gateCounter) {
+    if (truthV2) return DxrSequenceMode::TruthV2;
+    if (truthV1) return DxrSequenceMode::TruthV1;
+    if (diagnostic && gateCounter) return DxrSequenceMode::GateCounter;
+    if (diagnostic) return DxrSequenceMode::Diagnostic;
+    return DxrSequenceMode::None;
+}
+
+constexpr int DxrSequenceStageCount(DxrSequenceMode mode) {
+    switch (mode) {
+        case DxrSequenceMode::Diagnostic: return 8;
+        case DxrSequenceMode::TruthV1: return 6;
+        case DxrSequenceMode::TruthV2: return 4;
+        case DxrSequenceMode::GateCounter: return 2;
+        case DxrSequenceMode::None: return 0;
+    }
+    return 0;
+}
+
+constexpr int DxrSequenceStageFrames(DxrSequenceMode mode) {
+    return mode == DxrSequenceMode::GateCounter ? 1 : 600;
+}
+
+constexpr int DxrSequenceDuration(DxrSequenceMode mode) {
+    return DxrSequenceStageCount(mode) * DxrSequenceStageFrames(mode);
+}
+
+constexpr bool DxrSequenceComplete(DxrSequenceMode mode, int elapsedFrames) {
+    return mode != DxrSequenceMode::None && elapsedFrames >= DxrSequenceDuration(mode);
+}
+
+constexpr int DxrSequenceStage(DxrSequenceMode mode, int elapsedFrames) {
+    if (mode == DxrSequenceMode::None || elapsedFrames < 0 ||
+        elapsedFrames >= DxrSequenceDuration(mode)) return -1;
+    const int stage = elapsedFrames / DxrSequenceStageFrames(mode);
+    switch (mode) {
+        case DxrSequenceMode::Diagnostic: return stage;
+        case DxrSequenceMode::TruthV1: return 100 + stage;
+        case DxrSequenceMode::TruthV2: return 200 + stage;
+        case DxrSequenceMode::GateCounter: return 6 + stage;
+        case DxrSequenceMode::None: return -1;
+    }
+    return -1;
+}
+
+constexpr bool DxrSequenceCaptureDue(DxrSequenceMode mode, int elapsedFrames) {
+    return mode != DxrSequenceMode::None && elapsedFrames >= 0 &&
+           elapsedFrames < DxrSequenceDuration(mode) &&
+           elapsedFrames % DxrSequenceStageFrames(mode) == 0;
+}
+
+} // namespace Fast
