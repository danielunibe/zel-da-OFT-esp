+        ofs << line << "\n";
+    }
+    const char* harness = std::getenv("COUCH_DXR_HARNESS");
+    const char* outputRoot = std::getenv("COUCH_DXR_OUTPUT");
+    if (harness && std::strcmp(harness, "1") == 0 && outputRoot && *outputRoot) {
+        std::ofstream runLog(std::string(outputRoot) + "\\harness-dxr.log", std::ios::app);
+        if (runLog) runLog << line << '\n';
+    }
+}
+
+// Inversión analítica 4x4 mediante cofactores para desproyección NDC -> World
+static bool InvertMatrix4x4(const float m[4][4], float inv[4][4]) {
+    float invTmp[16];
+    const float* src = &m[0][0];
+
+    invTmp[0] = src[5]  * src[10] * src[15] - 
+                src[5]  * src[11] * src[14] - 
+                src[9]  * src[6]  * src[15] + 
+                src[9]  * src[7]  * src[14] +
+                src[13] * src[6]  * src[11] - 
+                src[13] * src[7]  * src[10];
+
+    invTmp[4] = -src[4]  * src[10] * src[15] + 
+                 src[4]  * src[11] * src[14] + 
+                 src[8]  * src[6]  * src[15] - 
+                 src[8]  * src[7]  * src[14] - 
+                 src[12] * src[6]  * src[11] + 
+                 src[12] * src[7]  * src[10];
+
+    invTmp[8] = src[4]  * src[9] * src[15] - 
+                src[4]  * src[11] * src[13] - 
+                src[8]  * src[5] * src[15] + 
+                src[8]  * src[7] * src[13] + 
+                src[12] * src[5] * src[11] - 
+                src[12] * src[7] * src[9];
+
+    invTmp[12] = -src[4]  * src[9] * src[14] + 
+                  src[4]  * src[10] * src[13] +
+                  src[8]  * src[5] * src[14] - 
+                  src[8]  * src[6] * src[13] - 
+                  src[12] * src[5] * src[10] + 
+                  src[12] * src[6] * src[9];
+
+    invTmp[1] = -src[1]  * src[10] * src[15] + 
+                 src[1]  * src[11] * src[14] + 
+                 src[9]  * src[2] * src[15] - 
+                 src[9]  * src[3] * src[14] - 
+                 src[13] * src[2] * src[11] + 
+                 src[13] * src[3] * src[10];
+
+    invTmp[5] = src[0]  * src[10] * src[15] - 
+                src[0]  * src[11] * src[14] - 
+                src[8]  * src[2] * src[15] + 
+                src[8]  * src[3] * src[14] + 
+                src[12] * src[2] * src[11] - 
+                src[12] * src[3] * src[10];
+
+    invTmp[9] = -src[0]  * src[9] * src[15] + 
+                 src[0]  * src[11] * src[13] + 
+                 src[8]  * src[1] * src[15] - 
+                 src[8]  * src[3] * src[13] - 
+                 src[12] * src[1] * src[11] + 
+                 src[12] * src[3] * src[9];
+
+    invTmp[13] = src[0]  * src[9] * src[14] - 
+                 src[0]  * src[10] * src[13] - 
+                 src[8]  * src[1] * src[14] + 
+                 src[8]  * src[2] * src[13] + 
+                 src[12] * src[1] * src[10] - 
+                 src[12] * src[2] * src[9];
+
+    invTmp[2] = src[1]  * src[6] * src[15] - 
+                src[1]  * src[7] * src[14] - 
+                src[5]  * src[2] * src[15] + 
+                src[5]  * src[3] * src[14] + 
+                src[13] * src[2] * src[7] - 
+                src[13] * src[3] * src[6];
+
+    invTmp[6] = -src[0]  * src[6] * src[15] + 
+                 src[0]  * src[7] * src[14] + 
+                 src[4]  * src[2] * src[15] - 
+                 src[4]  * src[3] * src[14] - 
+                 src[12] * src[2] * src[7] + 
+                 src[12] * src[3] * src[6];
+
+    invTmp[10] = src[0]  * src[5] * src[15] - 
+                 src[0]  * src[7] * src[13] - 
+                 src[4]  * src[1] * src[15] + 
+                 src[4]  * src[3] * src[13] + 
+                 src[12] * src[1] * src[7] - 
+                 src[12] * src[3] * src[5];
+
+    invTmp[14] = -src[0]  * src[5] * src[14] + 
+                  src[0]  * src[6] * src[13] + 
+                  src[4]  * src[1] * src[14] - 
+                  src[4]  * src[2] * src[13] - 
+                  src[12] * src[1] * src[6] + 
+                  src[12] * src[2] * src[5];
+
+    invTmp[3] = -src[1] * src[6] * src[11] + 
+                 src[1] * src[7] * src[10] + 
+                 src[5] * src[2] * src[11] - 
+                 src[5] * src[3] * src[10] - 
+                 src[9] * src[2] * src[7] + 
+                 src[9] * src[3] * src[6];
+
+    invTmp[7] = src[0] * src[6] * src[11] - 
+                src[0] * src[7] * src[10] - 
+                src[4] * src[2] * src[11] + 
+                src[4] * src[3] * src[10] + 
+                src[8] * src[2] * src[7] - 
+                src[8] * src[3] * src[6];
+
+    invTmp[11] = -src[0] * src[5] * src[11] + 
+                  src[0] * src[7] * src[9] + 
+                  src[4] * src[1] * src[11] - 
+                  src[4] * src[3] * src[9] - 
+                  src[8] * src[1] * src[7] + 
+                  src[8] * src[3] * src[5];
+
+    invTmp[15] = src[0] * src[5] * src[10] - 
+                 src[0] * src[6] * src[9] - 
+                 src[4] * src[1] * src[10] + 
+                 src[4] * src[2] * src[9] + 
+                 src[8] * src[1] * src[6] - 
+                 src[8] * src[2] * src[5];
+
+    float det = src[0] * invTmp[0] + src[1] * invTmp[4] + src[2] * invTmp[8] + src[3] * invTmp[12];
+    if (fabsf(det) < 1e-8f) return false;
+
+    float invDet = 1.0f / det;
+    for (int i = 0; i < 16; i++) {
+        (&inv[0][0])[i] = invTmp[i] * invDet;
+    }
+    return true;
+}
+
+typedef HRESULT(WINAPI* PFN_D3D12_SERIALIZE_ROOT_SIGNATURE)(const D3D12_ROOT_SIGNATURE_DESC*, D3D_ROOT_SIGNATURE_VERSION, ID3DBlob**, ID3DBlob**);
+
+static HRESULT DynamicD3D12SerializeRootSignature(const D3D12_ROOT_SIGNATURE_DESC* pRootSignature,
+                                                   D3D_ROOT_SIGNATURE_VERSION Version,
+                                                   ID3DBlob** ppBlob,
+                                                   ID3DBlob** ppErrorBlob) {
+    static PFN_D3D12_SERIALIZE_ROOT_SIGNATURE sFunc = nullptr;
+    if (!sFunc) {
+        HMODULE hD3D12 = GetModuleHandleA("d3d12.dll");
+        if (!hD3D12) hD3D12 = LoadLibraryA("d3d12.dll");
+        if (hD3D12) {
+            sFunc = (PFN_D3D12_SERIALIZE_ROOT_SIGNATURE)GetProcAddress(hD3D12, "D3D12SerializeRootSignature");
+        }
+    }
+    if (sFunc) {
+        return sFunc(pRootSignature, Version, ppBlob, ppErrorBlob);
+    }
+    return E_FAIL;
+}
