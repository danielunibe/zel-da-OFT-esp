+    auto cvars = Ship::Context::GetInstance()->GetConsoleVariables();
+    if (cvars && mat.type != MaterialType::PROTECTED_2D) {
+        const std::string typeName = [&mat] {
+            switch (mat.type) {
+                case MaterialType::STONE: return std::string("Stone");
