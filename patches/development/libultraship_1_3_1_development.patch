+void GfxRenderingAPIDX11::RunTonemappingPass(float fogR, float fogG, float fogB, float fogStrength, float fogStart, float fogRange) {
+    if (!mTonemapInitialized) {
+        mTonemapInitialized = true;
+    }
+
+    Fast::MaterialRegistry::IncrTonemapPass();
+    if (fogStrength > 0.001f) {
+        Fast::MaterialRegistry::IncrAtmosphericPass();
+    }
+    static bool sTonemapDiagnosticsLogged = false;
+    if (!sTonemapDiagnosticsLogged) {
+        sTonemapDiagnosticsLogged = true;
+        FILE* f = fopen(couch_diagnostics_path(), "a");
+        if (f) {
+            fprintf(f, "[COUCH] ACES pass executed\n");
+            fprintf(f, "[COUCH] Atmospheric pass executed\n");
+            fprintf(f, "[COUCH] MaterialRegistry active\n");
+            fprintf(f, "[COUCH] Material rules loaded = %zu\n", Fast::MaterialRegistry::Instance().GetExactRulesLoadedCount());
+            fclose(f);
+        }
+        printf("[COUCH] ACES pass executed\n");
+        printf("[COUCH] Atmospheric pass executed\n");
+        printf("[COUCH] MaterialRegistry active\n");
+        printf("[COUCH] Material rules loaded = %zu\n", Fast::MaterialRegistry::Instance().GetExactRulesLoadedCount());
+        fflush(stdout);
+    }
+
+    // Get current backbuffer
+    ComPtr<ID3D11Texture2D> backbuffer_tex;
+    HRESULT hr = mWindowBackend->GetSwapChain()->GetBuffer(0, IID_PPV_ARGS(backbuffer_tex.GetAddressOf()));
+    if (FAILED(hr) || !backbuffer_tex) return;
+
+    D3D11_TEXTURE2D_DESC bb_desc;
+    backbuffer_tex->GetDesc(&bb_desc);
+
+    // Resize copy texture if needed
+    if (!mTonemapCopyTex || bb_desc.Width != mTonemapCopyTexW || bb_desc.Height != mTonemapCopyTexH) {
+        mTonemapCopyTex.Reset();
+        mTonemapCopySRV.Reset();
+
+        D3D11_TEXTURE2D_DESC tex_desc = {};
+        tex_desc.Width = bb_desc.Width;
+        tex_desc.Height = bb_desc.Height;
+        tex_desc.MipLevels = 1;
+        tex_desc.ArraySize = 1;
+        tex_desc.Format = bb_desc.Format;
+        tex_desc.SampleDesc.Count = 1;
+        tex_desc.Usage = D3D11_USAGE_DEFAULT;
+        tex_desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+
+        hr = mDevice->CreateTexture2D(&tex_desc, nullptr, mTonemapCopyTex.GetAddressOf());
+        if (FAILED(hr)) return;
+
+        D3D11_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+        srv_desc.Format = tex_desc.Format;
+        srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        srv_desc.Texture2D.MipLevels = 1;
+
+        hr = mDevice->CreateShaderResourceView(mTonemapCopyTex.Get(), &srv_desc, mTonemapCopySRV.GetAddressOf());
+        if (FAILED(hr)) return;
+
+        mTonemapCopyTexW = bb_desc.Width;
+        mTonemapCopyTexH = bb_desc.Height;
+    }
+
+    // Reusable backbuffer RTV (created only on resize / initialization)
+    if (!mTonemapBackbufferRTV || mTonemapBackbufferW != bb_desc.Width || mTonemapBackbufferH != bb_desc.Height) {
+        mTonemapBackbufferRTV.Reset();
+        hr = mDevice->CreateRenderTargetView(backbuffer_tex.Get(), nullptr, mTonemapBackbufferRTV.GetAddressOf());
+        if (FAILED(hr)) return;
+        mTonemapBackbufferW = bb_desc.Width;
+        mTonemapBackbufferH = bb_desc.Height;
+    }
+
+    // Copy backbuffer to our SRV texture
+    mContext->CopyResource(mTonemapCopyTex.Get(), backbuffer_tex.Get());
+
+    // Save previous state completely (including DSV, viewport, scissor)
+    ComPtr<ID3D11RenderTargetView> prev_rtvs[D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    ComPtr<ID3D11DepthStencilView> prev_dsv;
+    mContext->OMGetRenderTargets(D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, prev_rtvs[0].GetAddressOf(), prev_dsv.GetAddressOf());
+    
+    UINT num_viewports = 1;
+    D3D11_VIEWPORT prev_viewport = {};
+    mContext->RSGetViewports(&num_viewports, &prev_viewport);
+
+    UINT num_scissors = 1;
+    D3D11_RECT prev_scissor = {};
+    mContext->RSGetScissorRects(&num_scissors, &prev_scissor);
+
+    ComPtr<ID3D11VertexShader> prev_vs;
+    ComPtr<ID3D11PixelShader> prev_ps;
+    ComPtr<ID3D11InputLayout> prev_il;
