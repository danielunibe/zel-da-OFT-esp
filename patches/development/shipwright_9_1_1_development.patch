diff --git a/soh/soh/Enhancements/glyphs/GlyphResolver.cpp b/soh/soh/Enhancements/glyphs/GlyphResolver.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..92096fcf419db9bde1a5dcd04a8cea901fe57ba8
--- /dev/null
+++ b/soh/soh/Enhancements/glyphs/GlyphResolver.cpp
@@ -0,0 +1,22 @@
+#include "glyph_resolver.h"
+
+/*
+ * PLAYABLE_SPANISH_BUILD_01 — Couch Edition
+ *
+ * G02 dynamic message glyphs are DISABLED FOR STABILITY.
+ *
+ * The dynamic Xbox glyph path (GlyphResolver -> LTBtn OTR resource swap inside
+ * the message text pipeline) was implicated in message-box crashes. Per the
+ * PLAYABLE_SPANISH_BUILD_01 policy:
+ *
+ *   - Physical controller mappings are NOT touched (LT still maps to N64 Z).
+ *   - Message boxes render the classic N64 Z glyph until G02 is re-validated.
+ *
+ * Returning NULL makes every call site fall back to the classic N64 glyph.
+ * This stub intentionally has no libultraship includes so the stability of the
+ * build never depends on the dynamic controller-detection code.
+ */
+
+extern "C" const char* GlyphResolver_GetZTexture(void) {
+    return nullptr;
+}
diff --git a/soh/soh/Enhancements/scene-harness/SceneTestHarness.cpp b/soh/soh/Enhancements/scene-harness/SceneTestHarness.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..256158218e5e524866e6a5afe83bf5e8bf97116b
--- /dev/null
+++ b/soh/soh/Enhancements/scene-harness/SceneTestHarness.cpp
@@ -0,0 +1,780 @@
+#include "soh/Enhancements/game-interactor/GameInteractor.h"
+#include "soh/ShipInit.hpp"
+#include "functions.h"
+
+extern "C" {
+#include "z64.h"
+#include "overlays/gamestates/ovl_file_choose/file_choose.h"
+}
+
+#include <nlohmann/json.hpp>
+
+#define NOMINMAX
+#include "fast/MaterialRegistry.h"
+#if defined(_WIN32)
+#include "fast/backends/DxrSurfaceRenderer.h"
+#endif
+#include "ship/Context.h"
+#include "ship/config/ConsoleVariable.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iterator>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <utility>
+
+extern "C" SaveContext gSaveContext;
+extern "C" PlayState* gPlayState;
+
+namespace {
+using Json = nlohmann::json;
+using namespace std::string_view_literals;
+
+enum class HarnessState { Disabled, Booting, SelectingSlot, WaitingForScene, Stabilizing, Capturing,
+                          CaptureComplete, Passed, Failed };
+
+bool IsHarnessTerminal(HarnessState state) {
+    return state == HarnessState::CaptureComplete || state == HarnessState::Passed ||
+           state == HarnessState::Failed;
+}
+
+struct HarnessConfig {
+    std::filesystem::path outputRoot;
+    Json manifest;
+    Json scenario;
+    Json view;
+    std::string scenarioId;
+    std::string viewId;
+    std::string truthMode;
+    int backendTruthMode = 0;
+    int entrance = -1;
+    int expectedScene = -1;
+    int expectedRoom = -1;
+    int linkAge = -1;
+    int dayTime = -1;
+    int nightFlag = -1;
+    int stableFramesRequired = 30;
+    int cameraWarmupFrames = 120;
+    int timeoutFrames = 1200;
+    bool freezeTime = true;
+    bool freezePlayer = true;
+};
+
+HarnessState sState = HarnessState::Disabled;
+HarnessConfig sConfig;
+std::uint64_t sGameFrame = 0;
