+    Set-Content -LiteralPath (Join-Path $runRoot 'RUN_FAIL') -Value 'HARNESS_ORIGINAL_SAVE_CHANGED' -Encoding utf8
+    [ordered]@{ status = 'FAIL'; blocker = 'HARNESS_ORIGINAL_SAVE_CHANGED'; pid = $process.Id; runId = $runId } |
