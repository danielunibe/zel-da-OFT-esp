+#include <cstdlib>
+#include <string_view>
 
 extern "C" SaveContext gSaveContext;
 using namespace std::string_literals;
 
+namespace {
+std::filesystem::path GetSaveDirectory() {
+    const std::filesystem::path normalPath(Ship::Context::GetPathRelativeToAppDirectory("Save"));
+    const char* harnessEnabled = std::getenv("COUCH_DXR_HARNESS");
+    if (!harnessEnabled || std::string_view(harnessEnabled) != "1") return normalPath;
+
+    const char* configuredRoot = std::getenv("COUCH_DXR_SAVE_ROOT");
+    if (!configuredRoot || !*configuredRoot) {
+        throw std::runtime_error("COUCH_DXR_SAVE_ROOT is required when the DXR harness is enabled");
+    }
+
+    std::error_code error;
+    const auto sandboxPath = std::filesystem::weakly_canonical(std::filesystem::absolute(configuredRoot), error);
+    if (error) throw std::runtime_error("Unable to resolve the scene harness save root");
+    error.clear();
+    const auto originalPath = std::filesystem::weakly_canonical(std::filesystem::absolute(normalPath), error);
+    if (error) throw std::runtime_error("Unable to resolve the normal save root for isolation check");
+
+    auto normalized = [](std::filesystem::path value) {
+        std::string text = value.generic_string();
+#ifdef _WIN32
+        std::transform(text.begin(), text.end(), text.begin(),
+                       [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+#endif
+        while (text.size() > 3 && text.back() == '/') text.pop_back();
+        return text;
+    };
+    if (normalized(sandboxPath) == normalized(originalPath)) {
+        throw std::runtime_error("Scene harness save root resolves to the original save directory");
+    }
+    return sandboxPath;
+}
+} // namespace
