diff --git a/soh/CMakeLists.txt b/soh/CMakeLists.txt
index 711dd8cb2cf254d5e762ed4436c7895d599f8707..6008d1741e860fa119f24ade8a09c67c2c8906d1 100644
--- a/soh/CMakeLists.txt
+++ b/soh/CMakeLists.txt
@@ -225,9 +225,26 @@ set(ALL_FILES
 ################################################################################
 add_executable(${PROJECT_NAME} ${ALL_FILES})
 
+# DXR TRUTH (V2) harness: configure with -DCOUCH_V2_EXE=ON to link the same
+# sources as soh_truth_v2.exe so V2 can be built/run while the V1 soh.exe
+# image stays locked/untouched. Inert (OFF) otherwise.
+option(COUCH_V2_EXE "Link soh sources as a separate truth exe (live exes untouched)" OFF)
+set(COUCH_V2_EXE_NAME "soh_truth_v2" CACHE STRING "Separate truth-exe file name (V2.5 uses soh_truth_v25)")
+message(STATUS "COUCH_V2_EXE=${COUCH_V2_EXE} COUCH_V2_EXE_NAME=${COUCH_V2_EXE_NAME}")
 if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
 use_props(${PROJECT_NAME} "${CMAKE_CONFIGURATION_TYPES}" "${DEFAULT_CXX_PROPS}")
 endif()
+# use_props (via CMake/Default.cmake) stamps per-config OUTPUT_NAME_<CONFIG> /
+# RUNTIME_OUTPUT_NAME_<CONFIG> = target name, which shadow a plain
+# OUTPUT_NAME. Override all of them AFTER use_props when COUCH_V2_EXE=ON.
+if(COUCH_V2_EXE)
+	set_target_properties(${PROJECT_NAME} PROPERTIES
+		OUTPUT_NAME "${COUCH_V2_EXE_NAME}" RUNTIME_OUTPUT_NAME "${COUCH_V2_EXE_NAME}"
+		OUTPUT_NAME_DEBUG "${COUCH_V2_EXE_NAME}" RUNTIME_OUTPUT_NAME_DEBUG "${COUCH_V2_EXE_NAME}"
+		OUTPUT_NAME_RELEASE "${COUCH_V2_EXE_NAME}" RUNTIME_OUTPUT_NAME_RELEASE "${COUCH_V2_EXE_NAME}"
+		OUTPUT_NAME_RELWITHDEBINFO "${COUCH_V2_EXE_NAME}" RUNTIME_OUTPUT_NAME_RELWITHDEBINFO "${COUCH_V2_EXE_NAME}"
+		OUTPUT_NAME_MINSIZEREL "${COUCH_V2_EXE_NAME}" RUNTIME_OUTPUT_NAME_MINSIZEREL "${COUCH_V2_EXE_NAME}")
+endif()
 
 set(ROOT_NAMESPACE soh)
 
